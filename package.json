{
  "name": "whatsapp-summary-bot",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Personal WhatsApp group summaries using a temporary message buffer and phone history",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "groups": "node --env-file=.env src/index.js --list-groups",
    "login": "node --env-file-if-exists=.env src/chatgpt-cli.js login",
    "logout": "node --env-file-if-exists=.env src/chatgpt-cli.js logout",
    "account": "node --env-file-if-exists=.env src/chatgpt-cli.js account",
    "models": "node --env-file-if-exists=.env src/chatgpt-cli.js models",
    "test": "node --test",
    "runtime:check": "node --env-file-if-exists=.env scripts/check-runtime.mjs"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "9.14.0",
    "qrcode-terminal": "0.12.0"
  }
}
