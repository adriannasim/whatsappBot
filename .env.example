# Copy this file to .env. Keep .env, credentials, and the message buffer private.
# chatgpt uses your authorised ChatGPT plan. Run npm run login first.
# api-key is a separate, explicitly selected paid API mode; there is no fallback.
AI_AUTH_MODE=chatgpt

# Run npm run models and paste an exact model ID here.
# Leave blank to use the account's first visible model; startup prints the choice.
OPENAI_MODEL=

# Only needed if you explicitly choose AI_AUTH_MODE=api-key.
OPENAI_API_KEY=

# Stores OAuth credentials and a stable installation ID, never message history.
CHATGPT_AUTH_DIR=./.chatgpt-auth

# Optional fixed loopback port for an SSH tunnel during login (0 = automatic).
CHATGPT_LOGIN_PORT=0

# Private linked-device credentials; old whatsapp-web.js sessions cannot be reused.
WA_AUTH_DIR=./.baileys-auth

# Private bounded message snapshot (cache.json): 24 hours, 3000/group, 32 MiB global
# retained content. Survives restarts; missed-message recovery remains best effort.
# Relative to the working directory: VM shared/ or the persistent container volume.
# Keep custom paths out of Git and long-lived backups. Does not store media.
RECENT_MESSAGES_DIR=./data/recent-messages

# First run npm run groups, then paste the exact group ID(s), comma-separated.
ALLOWED_GROUP_IDS=

# Maximum number of recent WhatsApp messages to try loading per command.
# This request limit is separate from the bounded saved incoming-message buffer.
MAX_HISTORY_MESSAGES=3000

# Keep the bot phone online so it can answer on-demand history requests.
# Per-request wait in milliseconds (5000 to 120000).
HISTORY_TIMEOUT_MS=60000
